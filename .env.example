# Amberleigh Private Bank Concierge - Environment Configuration Template
# Copy this file to '.env' and fill in your keys.

# Google Gemini Pro / Flash API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Admin Dashboard Password (Default: DBAdmin2026)
ADMIN_PASSCODE=YOUR_ADMIN_PASSWORD_HERE

# Local Development Port
PORT=8000
